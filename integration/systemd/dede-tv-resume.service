# Dede TV first-channel resume — integration template.
# Do not enable until Kodi and the native Rust binary are packaged, with
# a dedicated dede user, database and approved media directory.
[Unit]
Description=Dede TV restore last watched channel
After=kodi.service network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/dede-tv/core.sqlite
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=oneshot
User=dede
Group=dede
ExecStart=/usr/local/bin/dede-tv-core --db /var/lib/dede-tv/core.sqlite resume-last /srv/dede-tv/media
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/dede-tv
ReadOnlyPaths=/srv/dede-tv/media
UMask=0077

[Install]
WantedBy=multi-user.target
