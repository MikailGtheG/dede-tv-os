#!/bin/sh
set -eu
# Use a dedicated system UID: live-config may reserve UID 1000 for the live user.
if ! id dede >/dev/null 2>&1; then
  useradd --system --user-group --home-dir /home/dede --create-home \
    --shell /usr/sbin/nologin --groups video,audio,render,input dede
fi
chmod 0755 /usr/local/bin/dede-kodi-kiosk
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sfn ../dede-kodi.service /etc/systemd/system/multi-user.target.wants/dede-kodi.service
# Diagnostic-only timer for the experimental image; remove before release.
chmod 0755 /usr/local/bin/dede-kiosk-probe
mkdir -p /etc/systemd/system/timers.target.wants
ln -sfn ../dede-kiosk-probe.timer /etc/systemd/system/timers.target.wants/dede-kiosk-probe.timer
