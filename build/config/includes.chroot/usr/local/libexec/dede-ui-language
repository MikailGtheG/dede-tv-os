#!/usr/bin/env python3
"""Set Kodi's interface language from /etc/dede-tv/ui.conf before Kodi starts.

The administration console is the only place to change the language
(LANGUAGE=de|tr|en, written by dede-admin-apply). Kodi then picks the
matching skin texts. German is the default.
"""
import os
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

CONFIG = Path(os.environ.get("DEDE_UI_CONFIG", "/etc/dede-tv/ui.conf"))
SETTINGS = Path(os.environ.get("DEDE_KODI_SETTINGS",
                               str(Path.home() / ".kodi/userdata/guisettings.xml")))
LANGUAGES = {"de": "resource.language.de_de", "tr": "resource.language.tr_tr",
             "en": "resource.language.en_gb"}
DEFAULT = "de"


def configured(path=CONFIG):
    try:
        text = path.read_text(encoding="utf-8", errors="replace")[:4096]
    except OSError:
        return DEFAULT
    value = DEFAULT
    for line in text.splitlines():
        key, _, raw = line.strip().partition("=")
        if key == "LANGUAGE" and raw.strip() in LANGUAGES:
            value = raw.strip()
    return value


def apply(language, settings=SETTINGS):
    """Write locale.language into guisettings.xml; True if it changed."""
    if settings.is_symlink() or not settings.is_file():
        return False
    tree = ET.parse(settings)
    root = tree.getroot()
    wanted = LANGUAGES[language]
    node = next((s for s in root.iter("setting") if s.get("id") == "locale.language"), None)
    if node is not None and node.text == wanted and node.get("default") is None:
        return False
    if node is None:
        node = ET.SubElement(root, "setting", {"id": "locale.language"})
    node.attrib.pop("default", None)
    node.text = wanted
    temp = settings.with_name(f".{settings.name}.dede-language")
    tree.write(temp, encoding="utf-8", xml_declaration=False)
    os.replace(temp, settings)
    return True


def main():
    language = configured()
    try:
        changed = apply(language)
    except (ET.ParseError, OSError) as error:
        print(f"DEDE_LANGUAGE: not applied ({type(error).__name__})", file=sys.stderr)
        return 1
    print(f"DEDE_LANGUAGE: {language}{' (changed)' if changed else ''}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
