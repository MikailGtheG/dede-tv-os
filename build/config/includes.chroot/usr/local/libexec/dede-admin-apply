#!/usr/bin/env python3
"""Apply change requests from the Dede TV administration console (root).

dede-tv-admin runs without root rights and drops JSON requests into
/var/lib/dede-tv-admin/requests/. A systemd path unit starts this helper,
which validates every request again (it trusts nothing the web service
wrote), applies it and answers in results/<id>.json.

Request kinds:
  virtual-channels  full list of own channels -> /etc/dede-tv/virtual-channels.conf.
                    The TV restarts (dede-virtual-sync re-reads the folders) when
                    "refresh" is set or the channels that have films changed;
                    a new, still empty channel does not interrupt the picture.
  language          "de", "tr" or "en" -> /etc/dede-tv/ui.conf (interface language of
                    TV and console); the TV restarts when it changed.
  iptv              M3U (and optional EPG) address -> /etc/dede-tv/iptv.conf, checked
                    like dede-iptv-provision plus: no loopback or link-local hosts.
                    Addresses are never logged.
  wireguard-add     new remote device {name, endpoint}: keys are made here, the
                    device's configuration is answered once ("peer") and only its
                    public key is kept. /etc/dede-tv/remote.conf lists the devices.
  wireguard-remove  device {address}; the tunnel stops with the last device.
  tailscale-login   start Tailscale and answer the sign-in link ("login"); the
                    owner signs in on a phone. /etc/dede-tv/tailscale.conf holds
                    the state and the TV's Tailscale address.
  tailscale-status  refresh /etc/dede-tv/tailscale.conf.
  tailscale-logout  sign out and stop Tailscale.
"""
import importlib.machinery
import importlib.util
import ipaddress
import json
import os
import re
import stat
import subprocess
import sys
import time
import urllib.parse
from pathlib import Path

STATE = Path(os.environ.get("DEDE_ADMIN_STATE", "/var/lib/dede-tv-admin"))
CONFIG = Path(os.environ.get("DEDE_VIRTUAL_CONFIG", "/etc/dede-tv/virtual-channels.conf"))
UI_CONFIG = Path(os.environ.get("DEDE_UI_CONFIG", "/etc/dede-tv/ui.conf"))
IPTV_CONFIG = Path(os.environ.get("DEDE_IPTV_CONFIG", "/etc/dede-tv/iptv.conf"))
PROVISION = Path(os.environ.get("DEDE_IPTV_PROVISION", "/usr/local/libexec/dede-iptv-provision"))
LANGUAGES = ("de", "tr", "en")
SYNC = Path(os.environ.get("DEDE_VIRTUAL_SYNC", "/usr/local/libexec/dede-virtual-sync"))
RESTART = os.environ.get("DEDE_APPLY_RESTART", "systemctl restart --no-block dede-kodi.service")
REMOTE_CONFIG = Path(os.environ.get("DEDE_REMOTE_CONFIG", "/etc/dede-tv/remote.conf"))
WG_DIR = Path(os.environ.get("DEDE_WG_DIR", "/etc/wireguard"))
WG = os.environ.get("DEDE_WG", "wg")
SYSTEMCTL = os.environ.get("DEDE_SYSTEMCTL", "systemctl")
WG_UNIT = "wg-quick@dede0.service"
WG_PORT = 51820
WG_SERVER = ipaddress.ip_address("10.77.0.1")
WG_DEVICES = [ipaddress.ip_address(f"10.77.0.{n}") for n in range(2, 255)]
WG_KEY = re.compile(r"[A-Za-z0-9+/]{42}[AEIMQUYcgkosw480]=")
WG_NAME_MAX = 32
HOST_LABEL = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?")
TAILSCALE = os.environ.get("DEDE_TAILSCALE", "tailscale")
TS_CONFIG = Path(os.environ.get("DEDE_TS_CONFIG", "/etc/dede-tv/tailscale.conf"))
# tailscaled only starts while this file exists (drop-in condition).
TS_FLAG = Path(os.environ.get("DEDE_TS_FLAG", "/etc/dede-tv/tailscale.enabled"))
TS_UNIT = "tailscaled.service"
TS_WAIT = float(os.environ.get("DEDE_TS_WAIT", "20"))
TS_STATES = ("NeedsLogin", "Running", "Starting", "Stopped", "NeedsMachineAuth")
MAX_REQUEST = 64 * 1024
KEEP_RESULTS = 50
ID = re.compile(r"[0-9a-f]{32}")
FOLDER = re.compile(r"[a-z0-9][a-z0-9-]{0,63}")


class Refused(Exception):
    """Request rejected; the message is the error code shown to the user."""


def log(message):
    print(f"DEDE_ADMIN_APPLY: {message}", flush=True)


def load_module(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def load_sync():
    loader = importlib.machinery.SourceFileLoader("dede_virtual_sync", str(SYNC))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def read_request(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as error:
        raise Refused("bad-request") from error
    with os.fdopen(fd, "rb") as source:
        if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
            raise Refused("bad-request")
        data = source.read(MAX_REQUEST + 1)
    if len(data) > MAX_REQUEST:
        raise Refused("bad-request")
    try:
        request = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError) as error:
        raise Refused("bad-request") from error
    if not isinstance(request, dict) or request.get("id") != path.stem:
        raise Refused("bad-request")
    return request


def validate_channels(raw, sync):
    if not isinstance(raw, list) or len(raw) > sync.MAX_CHANNELS:
        raise Refused("bad-request")
    channels, numbers, names = [], set(), set()
    for entry in raw:
        if not isinstance(entry, dict) or set(entry) != {"name", "number", "folder"}:
            raise Refused("bad-request")
        name, number, folder = entry["name"], entry["number"], entry["folder"]
        if not isinstance(name, str) or not sync.valid_name(name) or name != name.strip() \
                or "[" in name or "]" in name or name in names:
            raise Refused("invalid-name")
        if not isinstance(number, int) or isinstance(number, bool) or not 1 <= number <= 9999:
            raise Refused("invalid-number")
        if number in numbers:
            raise Refused("duplicate-number")
        # Folders the console creates are one ASCII path component.
        if not isinstance(folder, str) or not FOLDER.fullmatch(folder):
            raise Refused("invalid-folder")
        try:
            sync.media_folder(folder)
        except sync.ConfigError as error:
            raise Refused("invalid-folder") from error
        names.add(name)
        numbers.add(number)
        channels.append({"name": name, "number": number, "folder": folder})
    return channels


def render(channels):
    lines = ["# Eigene Sender, verwaltet von der Dede TV Verwaltung."]
    for channel in sorted(channels, key=lambda c: c["number"]):
        lines += ["", f"[{channel['name']}]", f"number = {channel['number']}",
                  f"folder = {channel['folder']}"]
    return "\n".join(lines) + "\n"


def write_root_file(path, text, check=None, private=False):
    """Atomic, root-owned, readable by group dede (Kodi and the console).

    `check(temp)` may refuse the new content before it replaces the old.
    `private` files (keys) stay readable by root only.
    """
    mode = 0o600 if private else 0o640
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name(f".{path.name}.{os.getpid()}")
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as target:
            target.write(text)
            target.flush()
            os.fsync(target.fileno())
        try:
            import grp
            os.chown(temp, 0, 0 if private else grp.getgrnam("dede").gr_gid)
        except (KeyError, PermissionError):
            pass
        os.chmod(temp, mode)
        if check is not None:
            check(temp)
        os.replace(temp, path)
    except BaseException:
        temp.unlink(missing_ok=True)
        raise


def write_config(text, expected, sync, path=CONFIG):
    """The new file must read back exactly as dede-virtual-sync will read it."""
    def check(temp):
        try:
            if sync.read_config(temp, require_root_owner=os.geteuid() == 0) != expected:
                raise Refused("bad-request")
        except sync.ConfigError as error:
            raise Refused("bad-request") from error
    write_root_file(path, text, check)


def current_language(path=UI_CONFIG):
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            key, _, value = line.strip().partition("=")
            if key == "LANGUAGE" and value.strip() in LANGUAGES:
                return value.strip()
    except OSError:
        pass
    return "de"


def apply_language(request):
    language = request.get("language")
    if set(request) != {"id", "kind", "language"} or language not in LANGUAGES:
        raise Refused("bad-request")
    changed = language != current_language()
    write_root_file(UI_CONFIG, f"# Sprache von Fernseher und Verwaltung (de, tr, en).\nLANGUAGE={language}\n")
    if changed:
        log(f"language {language}, restarting the TV")
        subprocess.run(RESTART.split(), check=False, timeout=30)


def on_air(channels, sync):
    """Channels the TV would show: those whose folder holds films."""
    shown = set()
    for channel in channels or []:
        try:
            if sync.discover(sync.media_folder(channel["folder"])):
                shown.add((channel["name"], channel["number"], channel["folder"]))
        except (sync.ConfigError, OSError):
            pass
    return shown


def public_host(url):
    """Refuse addresses that point back at this device or its link."""
    try:
        host = urllib.parse.urlsplit(url).hostname
    except ValueError:
        return False
    if not host or host == "localhost" or host.endswith(".localhost"):
        return False
    try:
        address = ipaddress.ip_address(host)
    except ValueError:
        return True
    return not (address.is_loopback or address.is_link_local or address.is_unspecified
                or address.is_multicast)


def apply_iptv(request):
    if set(request) != {"id", "kind", "m3u_url", "epg_url"}:
        raise Refused("bad-request")
    provision = load_module("dede_iptv_provision", PROVISION)
    values = {}
    for key, field in (("M3U_URL", "m3u_url"), ("EPG_URL", "epg_url")):
        value = request[field]
        if not isinstance(value, str):
            raise Refused("bad-request")
        if not value and key == "EPG_URL":
            continue
        try:
            provision.validate_url(value, key)
        except provision.ConfigError as error:
            raise Refused("invalid-address") from error
        if not public_host(value):
            raise Refused("local-address")
        values[key] = value
    text = "".join(f"{key}={value}\n" for key, value in values.items())
    try:
        changed = provision.read_config(IPTV_CONFIG, require_root_owner=False) != values
    except provision.ConfigError:
        changed = True

    def check(temp):
        try:
            if provision.read_config(temp, require_root_owner=os.geteuid() == 0) != values:
                raise Refused("bad-request")
        except provision.ConfigError as error:
            raise Refused("invalid-address") from error
    write_root_file(IPTV_CONFIG, text, check)
    if changed:
        log("IPTV source changed, restarting the TV")
        subprocess.run(RESTART.split(), check=False, timeout=30)


def valid_device_name(name):
    return (isinstance(name, str) and 1 <= len(name) <= WG_NAME_MAX and name.strip() == name
            and all(c.isalnum() or c in " -_." for c in name))


def normalise_endpoint(endpoint):
    """`host[:port]` (DNS name, IPv4 or [IPv6]) with the port filled in, or None."""
    if not isinstance(endpoint, str) or len(endpoint) > 260:
        return None
    match = re.fullmatch(r"\[([0-9A-Fa-f:.]+)\](?::(\d{1,5}))?", endpoint)
    if match:
        try:
            ipaddress.IPv6Address(match.group(1))
        except ValueError:
            return None
        host, port = f"[{match.group(1)}]", match.group(2)
    else:
        host, _, port = endpoint.partition(":")
        if _ and not port:
            return None
        port = port or None
        try:
            ipaddress.IPv4Address(host)
        except ValueError:
            labels = host.split(".")
            if (len(host) > 253 or not all(HOST_LABEL.fullmatch(label) for label in labels)
                    or not re.search(r"[A-Za-z]", host)):
                return None
    if port is not None and not (port.isascii() and port.isdigit() and 0 < int(port) < 65536):
        return None
    return f"{host}:{port or WG_PORT}"


def read_remote(path=REMOTE_CONFIG):
    """(endpoint, [(address, public key, name)]) as last written by this helper."""
    endpoint, devices = None, []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return endpoint, devices
    for line in lines:
        key, _, value = line.partition("=")
        if key == "WG_ENDPOINT" and normalise_endpoint(value) == value:
            endpoint = value
        elif key == "WG_DEVICE":
            parts = value.split(" ", 2)
            if (len(parts) == 3 and WG_KEY.fullmatch(parts[1]) and valid_device_name(parts[2])
                    and parts[0] in {str(a) for a in WG_DEVICES}):
                devices.append(tuple(parts))
    return endpoint, devices


def render_remote(endpoint, devices):
    lines = ["# Fernzugriff (WireGuard), geschrieben von dede-admin-apply."]
    if endpoint:
        lines.append(f"WG_ENDPOINT={endpoint}")
    lines += [f"WG_DEVICE={address} {key} {name}" for address, key, name in devices]
    return "\n".join(lines) + "\n"


def wg(*args, data=None):
    result = subprocess.run([WG, *args], input=data, capture_output=True, text=True,
                            check=True, timeout=10)
    key = result.stdout.strip()
    if not WG_KEY.fullmatch(key):
        raise Refused("key-failed")
    return key


def server_private_key():
    path = WG_DIR / "dede0.key"
    try:
        key = path.read_text(encoding="ascii").strip()
        if WG_KEY.fullmatch(key):
            return key
    except (OSError, UnicodeDecodeError):
        pass
    key = wg("genkey")
    write_root_file(path, key + "\n", private=True)
    return key


def write_tunnel(devices):
    """dede0.conf for wg-quick; without devices the tunnel is stopped and removed."""
    path = WG_DIR / "dede0.conf"
    if not devices:
        subprocess.run([SYSTEMCTL, "stop", WG_UNIT], check=False, timeout=30)
        path.unlink(missing_ok=True)
        return
    lines = ["[Interface]", f"Address = {WG_SERVER}/24", f"ListenPort = {WG_PORT}",
             f"PrivateKey = {server_private_key()}"]
    for address, key, name in devices:
        lines += ["", f"# {name}", "[Peer]", f"PublicKey = {key}", f"AllowedIPs = {address}/32"]
    write_root_file(path, "\n".join(lines) + "\n", private=True)
    subprocess.run([SYSTEMCTL, "restart", WG_UNIT], check=False, timeout=30)


def apply_wireguard_add(request):
    if set(request) != {"id", "kind", "name", "endpoint"}:
        raise Refused("bad-request")
    name = request["name"]
    endpoint = normalise_endpoint(request["endpoint"])
    if not valid_device_name(name) or endpoint is None:
        raise Refused("bad-request")
    _, devices = read_remote()
    used = {address for address, _, _ in devices}
    free = [str(a) for a in WG_DEVICES if str(a) not in used]
    if not free:
        raise Refused("too-many-devices")
    private = wg("genkey")
    public = wg("pubkey", data=private + "\n")
    server = wg("pubkey", data=server_private_key() + "\n")
    devices.append((free[0], public, name))
    write_tunnel(devices)
    write_root_file(REMOTE_CONFIG, render_remote(endpoint, devices))
    log(f"WireGuard device {free[0]} added")
    return {"peer": "\n".join([
        "[Interface]", f"PrivateKey = {private}", f"Address = {free[0]}/32", "",
        "[Peer]", f"PublicKey = {server}", f"Endpoint = {endpoint}",
        f"AllowedIPs = {WG_SERVER}/32", "PersistentKeepalive = 25", ""])}


def apply_wireguard_remove(request):
    if set(request) != {"id", "kind", "address"}:
        raise Refused("bad-request")
    endpoint, devices = read_remote()
    remaining = [d for d in devices if d[0] != request["address"]]
    if len(remaining) == len(devices):
        raise Refused("unknown-device")
    write_tunnel(remaining)
    write_root_file(REMOTE_CONFIG, render_remote(endpoint, remaining))
    log(f"WireGuard device {request['address']} removed")


def tailscale_status():
    """(state, login link, Tailscale IPv4) from the running daemon."""
    try:
        result = subprocess.run([TAILSCALE, "status", "--json"], capture_output=True, text=True,
                                check=False, timeout=10)
        status = json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None, None, None
    if not isinstance(status, dict):
        return None, None, None
    state = status.get("BackendState")
    state = state if state in TS_STATES else None
    link = status.get("AuthURL")
    if not (isinstance(link, str) and link.startswith("https://") and len(link) <= 512
            and not any(c.isspace() or not c.isprintable() for c in link)):
        link = None
    address = None
    own = status.get("Self")
    for candidate in (own.get("TailscaleIPs") if isinstance(own, dict) else None) or []:
        try:
            ip = ipaddress.ip_address(candidate)
        except (TypeError, ValueError):
            continue
        if ip.version == 4 and ip in ipaddress.ip_network("100.64.0.0/10"):
            address = str(ip)
            break
    return state, link, address


def write_tailscale_state(state, address):
    lines = ["# Tailscale, geschrieben von dede-admin-apply.", f"TS_STATE={state or 'Stopped'}"]
    if address and state == "Running":
        lines.append(f"TS_ADDRESS={address}")
    write_root_file(TS_CONFIG, "\n".join(lines) + "\n")


def wait_for_tailscale(done):
    deadline = time.monotonic() + TS_WAIT
    while True:
        status = tailscale_status()
        if done(*status) or time.monotonic() >= deadline:
            return status
        time.sleep(1)


def apply_tailscale(request):
    kind = request["kind"]
    if set(request) != {"id", "kind"}:
        raise Refused("bad-request")
    if kind == "tailscale-logout":
        subprocess.run([TAILSCALE, "logout"], capture_output=True, check=False, timeout=30)
        subprocess.run([SYSTEMCTL, "stop", TS_UNIT], check=False, timeout=30)
        TS_FLAG.unlink(missing_ok=True)
        write_tailscale_state("Stopped", None)
        log("Tailscale signed out")
        return None
    if kind == "tailscale-status":
        state, _, address = tailscale_status() if TS_FLAG.exists() else ("Stopped", None, None)
        write_tailscale_state(state, address)
        return None
    write_root_file(TS_FLAG, "")
    subprocess.run([SYSTEMCTL, "start", TS_UNIT], check=False, timeout=30)
    wait_for_tailscale(lambda state, link, address: state is not None)
    # "up" waits for the sign-in; the link shows up in the status meanwhile.
    try:
        subprocess.run([TAILSCALE, "up", "--hostname=dede-tv", "--accept-dns=false",
                        "--timeout=5s"], capture_output=True, check=False, timeout=30)
    except subprocess.TimeoutExpired:
        pass
    state, link, address = wait_for_tailscale(
        lambda state, link, address: state == "Running" or link is not None)
    write_tailscale_state(state, address)
    if state == "Running":
        log("Tailscale already signed in")
        return None
    if link is None:
        raise Refused("tailscale-unreachable")
    log("Tailscale sign-in link created")
    return {"login": link}


def apply(request, sync):
    """Apply one request; returns a new device's configuration, if any."""
    if request.get("kind") == "wireguard-add":
        return apply_wireguard_add(request)
    if request.get("kind") == "wireguard-remove":
        return apply_wireguard_remove(request)
    if request.get("kind") in ("tailscale-login", "tailscale-status", "tailscale-logout"):
        return apply_tailscale(request)
    if request.get("kind") == "iptv":
        return apply_iptv(request)
    if request.get("kind") == "language":
        return apply_language(request)
    if request.get("kind") != "virtual-channels":
        raise Refused("unknown-kind")
    refresh = request.get("refresh", False)
    if not isinstance(refresh, bool):
        raise Refused("bad-request")
    channels = validate_channels(request.get("channels"), sync)
    try:
        before = on_air(sync.read_config(CONFIG), sync)
    except sync.ConfigError:
        before = None
    write_config(render(channels), sorted(channels, key=lambda c: c["number"]), sync)
    if refresh or before != on_air(channels, sync):
        log(f"{len(channels)} own channels written, restarting the TV")
        subprocess.run(RESTART.split(), check=False, timeout=30)
    else:
        log(f"{len(channels)} own channels written, nothing new on air")


def answer(results, request_id, ok, error=None, owner=None, extra=None):
    results.mkdir(mode=0o700, exist_ok=True)
    target = results / f"{request_id}.json"
    temp = results / f".{request_id}.tmp"
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as out:
        json.dump({"id": request_id, "ok": ok, **({"error": error} if error else {}),
                   **(extra or {})}, out)
    if owner is not None:
        os.chown(temp, owner.st_uid, owner.st_gid)
        os.chown(results, owner.st_uid, owner.st_gid)
    os.chmod(temp, 0o600)
    os.replace(temp, target)
    old = sorted(results.glob("*.json"), key=lambda p: p.stat().st_mtime)
    for stale in old[:-KEEP_RESULTS]:
        stale.unlink(missing_ok=True)


def main():
    requests = STATE / "requests"
    if not requests.is_dir() or requests.is_symlink():
        return 0
    owner = STATE.stat()
    sync = None
    for path in sorted(requests.glob("*.json")):
        request_id = path.stem
        extra = None
        try:
            if not ID.fullmatch(request_id):
                raise Refused("bad-request")
            request = read_request(path)
            if sync is None:
                sync = load_sync()
            extra = apply(request, sync)
            ok, error = True, None
        except Refused as refusal:
            ok, error = False, str(refusal)
        except (OSError, subprocess.SubprocessError) as failure:
            log(f"request failed: {type(failure).__name__}")
            ok, error = False, "write-failed"
        finally:
            path.unlink(missing_ok=True)
        log(f"request {request_id[:8]}: {'ok' if ok else error}")
        if ID.fullmatch(request_id):
            answer(STATE / "results", request_id, ok, error, owner, extra if ok else None)
    return 0


if __name__ == "__main__":
    sys.exit(main())
