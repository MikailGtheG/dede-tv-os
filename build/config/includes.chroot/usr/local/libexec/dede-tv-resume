#!/bin/sh
# Resume the selected channel after Kodi has started. No unattended writes
# to the TV database are performed when the core is unavailable.
set -eu
core="${DEDE_CORE_BIN:-/usr/local/bin/dede-tv-core}"
db="${DEDE_DB_PATH:-/home/dede/.local/share/dede-tv/channels.db}"
media="${DEDE_MEDIA_ROOT:-/srv/dede-tv/media}"
attempts="${DEDE_RESUME_ATTEMPTS:-20}"
delay="${DEDE_RESUME_DELAY:-2}"
call_timeout="${DEDE_RESUME_CALL_TIMEOUT:-5}"
case "$attempts" in ''|*[!0-9]*) echo "Invalid resume attempt count" >&2; exit 2;; esac
[ "$attempts" -ge 1 ] && [ "$attempts" -le 60 ] || exit 2
case "$delay" in ''|*[!0-9]*) echo "Invalid resume delay" >&2; exit 2;; esac
[ "$delay" -le 10 ] || exit 2
case "$call_timeout" in ''|*[!0-9]*) echo "Invalid resume call timeout" >&2; exit 2;; esac
[ "$call_timeout" -ge 1 ] && [ "$call_timeout" -le 10 ] || exit 2
[ -x "$core" ] || { echo "Dede TV core not installed; skipping resume"; exit 0; }
# Reject symlinks before testing file existence: a dangling symlink fails -f
# and must not be mistaken for a normal first boot without a database.
[ ! -L "$db" ] || { echo "Symlinked TV channel database refused" >&2; exit 1; }
[ -f "$db" ] || { echo "No saved TV channel database; skipping resume"; exit 0; }
# Pin the original database identity across retries. A regular-file replacement
# must not silently change which channel list unattended playback uses.
command -v timeout >/dev/null 2>&1 || { echo "GNU timeout is required for bounded playback resume" >&2; exit 1; }
db_identity=$(stat -Lc '%d:%i' -- "$db") || exit 1
attempt=1
while [ "$attempt" -le "$attempts" ]; do
  # Recheck immediately before each invocation: the database can be replaced
  # while waiting between attempts, not only during a failed core call.
  if [ ! -f "$db" ] || [ -L "$db" ] ||
     [ "$(stat -Lc '%d:%i' -- "$db" 2>/dev/null || true)" != "$db_identity" ]; then
    echo "TV channel database changed during resume; aborting" >&2
    exit 1
  fi
  if timeout --signal=TERM --kill-after=2s "${call_timeout}s" "$core" --db "$db" resume-last "$media"; then
    # A successful core return does not prove the channel store stayed stable.
    # Reject a replacement that happened while the playback call was running.
    if [ ! -f "$db" ] || [ -L "$db" ] ||
       [ "$(stat -Lc '%d:%i' -- "$db" 2>/dev/null || true)" != "$db_identity" ]; then
      echo "TV channel database changed during resume; aborting" >&2
      exit 1
    fi
    exit 0
  fi
  # The channel store may be removed or replaced during administration.
  # Never retry against a vanished or redirected database path.
  if [ ! -f "$db" ] || [ -L "$db" ] ||
     [ "$(stat -Lc '%d:%i' -- "$db" 2>/dev/null || true)" != "$db_identity" ]; then
    echo "TV channel database changed during resume; aborting" >&2
    exit 1
  fi
  if [ "$attempt" -lt "$attempts" ]; then
    sleep "$delay"
  fi
  attempt=$((attempt + 1))
done
echo "Dede TV resume failed after $attempts attempts" >&2
exit 1
