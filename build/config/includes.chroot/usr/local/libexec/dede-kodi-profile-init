#!/bin/sh
# First boot only: configure local Kodi playback API and the packaged TV skin.
# Respect existing administrator-managed Kodi settings on subsequent boots.
set -eu
umask 077
: "${HOME:?Kodi HOME is not set}"
profile="$HOME/.kodi/userdata"
# Never follow a redirected profile directory into an arbitrary location.
if [ -L "$HOME/.kodi" ] || [ -L "$profile" ]; then
  echo "Symlinked Kodi profile directory; refusing kiosk startup" >&2
  exit 1
fi
mkdir -p "$profile"
advanced="$profile/advancedsettings.xml"
settings="$profile/guisettings.xml"
skin_addon="${DEDE_SKIN_ADDON:-/usr/share/kodi/addons/skin.dede-tv/addon.xml}"
# Fail closed before writing any persistent Kodi settings. Never seed Estuary.
if [ ! -f "$skin_addon" ] || ! grep -Fq 'id="skin.dede-tv"' "$skin_addon"; then
  echo "Dede TV skin metadata missing or invalid; refusing profile initialization" >&2
  exit 1
fi
tmp_advanced=
tmp_settings=
cleanup() {
  [ -z "$tmp_advanced" ] || rm -f "$tmp_advanced"
  [ -z "$tmp_settings" ] || rm -f "$tmp_settings"
}
trap cleanup EXIT HUP INT TERM

if [ ! -e "$advanced" ] && [ ! -L "$advanced" ]; then
  tmp_advanced="$(mktemp "$profile/.dede-advancedsettings.XXXXXX")"
  cat > "$tmp_advanced" <<'XML'
<advancedsettings version="1.0">
  <splash>false</splash>
  <fullscreen>true</fullscreen>
  <showexitbutton>false</showexitbutton>
</advancedsettings>
XML
  if [ ! -e "$advanced" ] && [ ! -L "$advanced" ]; then
    mv -n "$tmp_advanced" "$advanced"
  fi
fi

# An existing profile may have been created by stock Kodi or an administrator.
# Never launch the kiosk with a saved non-Dede skin selection.
if [ -e "$settings" ] || [ -L "$settings" ]; then
  # Parse XML rather than matching lines: Kodi may nest settings, change
  # attribute order, or serialize values across multiple lines.
  if [ ! -f "$settings" ] || [ -L "$settings" ] || ! python3 - "$settings" <<'PY'
import sys
import xml.etree.ElementTree as ET

try:
    root = ET.parse(sys.argv[1]).getroot()
    if root.tag != "settings":
        raise ValueError("unexpected Kodi settings root")
    values = {}
    for setting in root.iter("setting"):
        key = setting.get("id")
        if key in ("lookandfeel.skin", "services.webserver", "services.esallinterfaces"):
            if key in values:
                raise ValueError("duplicate security-sensitive Kodi setting")
            values[key] = (setting.text or "").strip()
    if values.get("lookandfeel.skin") != "skin.dede-tv":
        raise ValueError("Dede TV skin is not selected")
    if any(values.get(key, "false").lower() != "false" for key in
           ("services.webserver", "services.esallinterfaces")):
        raise ValueError("network-facing Kodi controls are enabled")
except (ET.ParseError, OSError, ValueError) as exc:
    print(f"Unsafe Kodi profile: {exc}", file=sys.stderr)
    sys.exit(1)
PY
  then
    echo "Existing Kodi profile failed security validation; refusing kiosk startup" >&2
    exit 1
  fi
fi

if [ ! -e "$settings" ] && [ ! -L "$settings" ]; then
  tmp_settings="$(mktemp "$profile/.dede-guisettings.XXXXXX")"
  cat > "$tmp_settings" <<XML
<settings version="2">
  <setting id="services.esenabled">true</setting>
  <setting id="services.esallinterfaces">false</setting>
  <setting id="services.webserver">false</setting>
  <setting id="lookandfeel.skin">skin.dede-tv</setting>
</settings>
XML
  if [ ! -e "$settings" ] && [ ! -L "$settings" ]; then
    mv -n "$tmp_settings" "$settings"
  fi
fi
