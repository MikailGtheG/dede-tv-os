#!/usr/bin/python3
"""Restart a hung Kodi (process alive, but not answering) in a controlled way.

Crashes are already handled by dede-kodi.service (Restart=always). A hang
keeps the process alive with a frozen picture, so this service pings Kodi's
loopback JSON-RPC every CHECK_INTERVAL_S over ONE persistent connection
(Kodi 21's JSON-RPC TCP server can crash when a client disconnects during
an announcement; fixed upstream after 21.x) and restarts Kodi only when:
  * the service has been active for at least GRACE_S (Kodi starts slowly),
  * FAILURES_NEEDED consecutive checks failed, and
  * no watchdog restart happened within the last MIN_INTERVAL_S
    (never an endless restart loop).
State lives in /run (cleared on reboot). Exit status is always 0 unless the
restart command itself fails.
"""
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.environ.get("DEDE_TV_LIB", "/usr/local/lib/dede-tv"))
from dede_kodi_rpc import Connection, RpcError  # noqa: E402

STATE = os.environ.get("DEDE_WATCHDOG_STATE", "/run/dede-kodi-watchdog.json")
GRACE_S = 120
FAILURES_NEEDED = 3
MIN_INTERVAL_S = 600
SERVICE = "dede-kodi.service"


CHECK_INTERVAL_S = 30


class Pinger:
    """JSONRPC.Ping over one long-lived connection; reconnect only after a
    failure (Kodi restarted or not answering)."""

    def __init__(self, connect=None):
        self.connect = connect or Connection
        self.connection = None

    def __call__(self, timeout=10.0):
        try:
            if self.connection is None:
                self.connection = self.connect()
            healthy = self.connection.call("JSONRPC.Ping", timeout=timeout) == "pong"
            self.connection.notifications()  # drop queued announcements
            return healthy
        except (OSError, RpcError):
            if self.connection is not None:
                self.connection.close()
                self.connection = None
            return False


def active_seconds():
    """Seconds since dede-kodi.service became active, or None if inactive."""
    out = subprocess.run(
        ["systemctl", "show", SERVICE, "-p", "ActiveState", "-p", "ActiveEnterTimestampMonotonic"],
        capture_output=True, text=True, check=False).stdout
    values = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
    if values.get("ActiveState") != "active":
        return None
    try:
        entered_us = int(values.get("ActiveEnterTimestampMonotonic", "0"))
    except ValueError:
        return None
    return time.clock_gettime(time.CLOCK_MONOTONIC) - entered_us / 1e6


def load(path=STATE):
    try:
        with open(path, encoding="ascii") as source:
            data = json.load(source)
        return {"failures": int(data.get("failures", 0)),
                "last_restart": float(data.get("last_restart", -1e12))}
    except (OSError, ValueError, TypeError, AttributeError):
        return {"failures": 0, "last_restart": -1e12}


def save(state, path=STATE):
    temporary = path + ".tmp"
    with open(temporary, "w", encoding="ascii") as output:
        json.dump(state, output)
    os.replace(temporary, path)


def decide(state, uptime, healthy, now):
    """Return (new_state, restart?) for one check. Pure: unit-tested."""
    if uptime is None or uptime < GRACE_S or healthy:
        return {"failures": 0, "last_restart": state["last_restart"]}, False
    failures = state["failures"] + 1
    if failures >= FAILURES_NEEDED and now - state["last_restart"] >= MIN_INTERVAL_S:
        return {"failures": 0, "last_restart": now}, True
    return {"failures": failures, "last_restart": state["last_restart"]}, False


def check(ping):
    now = time.clock_gettime(time.CLOCK_MONOTONIC)
    uptime = active_seconds()
    healthy = ping() if uptime is not None and uptime >= GRACE_S else True
    state, restart = decide(load(), uptime, healthy, now)
    save(state)
    if not healthy:
        print(f"DEDE_WATCHDOG: Kodi not answering ({state['failures']}/{FAILURES_NEEDED})", flush=True)
    if restart:
        print("DEDE_WATCHDOG: Kodi hung, restarting dede-kodi.service", flush=True)
        subprocess.run(["systemctl", "restart", "--no-block", SERVICE], check=False)


def main():
    ping = Pinger()
    while True:
        check(ping)
        time.sleep(CHECK_INTERVAL_S)


if __name__ == "__main__":
    sys.exit(main())
