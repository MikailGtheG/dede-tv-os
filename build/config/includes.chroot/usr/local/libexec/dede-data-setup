#!/usr/bin/env python3
"""Keep settings, films and sign-ins across restarts (first start on a disk).

The image boots with `persistence persistence-label=dede-data`: live-boot
bind-mounts the folders listed in PERSISTENT from a partition with that
label. On the first start from a disk (the ISO written to an SSD or USB
stick) this helper adds that partition in the free space behind the image on
the same disk, copies the current folders into it and restarts.

It never touches any other disk, and does nothing when booted from a CD,
when the partition already exists or when there is not enough free space.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

LABEL = "dede-data"
MIN_FREE = 1 << 30
SECTOR = 512
# Folder on the TV -> folder on the data partition.
PERSISTENT = (
    ("/etc/dede-tv", "etc-dede-tv"),
    ("/etc/wireguard", "etc-wireguard"),
    ("/var/lib/dede-tv-admin", "var-lib-dede-tv-admin"),
    ("/var/lib/tailscale", "var-lib-tailscale"),
    ("/srv/dede-tv", "srv-dede-tv"),
    ("/home/dede", "home-dede"),
)
CMDLINE = Path(os.environ.get("DEDE_CMDLINE", "/proc/cmdline"))
MEDIUM = os.environ.get("DEDE_LIVE_MEDIUM", "/run/live/medium")
REBOOT = os.environ.get("DEDE_DATA_REBOOT", "systemctl --no-block reboot").split()


class Skip(Exception):
    """Nothing to do; the message says why."""


def log(message):
    print(f"DEDE_DATA: {message}", flush=True)


def run(*args, data=None):
    return subprocess.run(args, input=data, capture_output=True, text=True, check=True,
                          timeout=120).stdout


def persistence_conf():
    return "".join(f"{target} source={source}\n" for target, source in PERSISTENT)


def boot_disk():
    """The whole disk the image was started from, or Skip."""
    if f"persistence-label={LABEL}" not in CMDLINE.read_text().split():
        raise Skip("image without data partition support")
    source = run("findmnt", "-n", "-o", "SOURCE", MEDIUM).strip()
    if not re.fullmatch(r"/dev/[a-z0-9]+", source):
        raise Skip(f"unexpected boot medium {source!r}")
    info = json.loads(run("lsblk", "-J", "-b", "-o", "NAME,TYPE,PKNAME,RO,RM,SIZE", source))
    device = info["blockdevices"][0]
    disk = device["name"] if device["type"] == "disk" else device.get("pkname")
    if device["type"] == "rom" or not disk:
        raise Skip("started from a CD")
    return f"/dev/{disk}"


def plan(disk):
    """Start and size (sectors) of the new partition, or Skip."""
    labels = run("lsblk", "-n", "-o", "LABEL").split()
    if LABEL in labels:
        kept = all(os.path.ismount(target) for target, _ in PERSISTENT)
        raise Skip("data partition in use" if kept else "data partition present but not in use")
    table = json.loads(run("sfdisk", "-J", disk))["partitiontable"]
    if table.get("label") != "dos":
        raise Skip(f"partition table {table.get('label')!r} not supported")
    parts = table.get("partitions", [])
    if len(parts) >= 4:
        raise Skip("no free partition slot")
    size = int(run("blockdev", "--getsz", disk))
    end = max(p["start"] + p["size"] for p in parts) if parts else 0
    start = -(-end // 2048) * 2048
    if (size - start) * SECTOR < MIN_FREE:
        raise Skip("not enough free space behind the image")
    return start, size - start, len(parts) + 1


def create(disk, start, size, number):
    # The image's own partitions stay mounted, so the kernel learns only the
    # new one (partx) instead of re-reading the whole table.
    run("sfdisk", "--append", "--no-reread", "--no-tell-kernel", disk,
        data=f"start={start}, size={size}, type=83\n")
    partition = f"{disk}{'p' if disk[-1].isdigit() else ''}{number}"
    run("partx", "--add", "--nr", str(number), disk)
    run("udevadm", "settle")
    run("mkfs.ext4", "-q", "-F", "-L", LABEL, partition)
    with tempfile.TemporaryDirectory() as mount:
        run("mount", partition, mount)
        try:
            for target, source in PERSISTENT:
                # Today's content is the starting point of the kept folders.
                os.makedirs(target, exist_ok=True)
                Path(mount, source).mkdir()
                run("cp", "-a", f"{target}/.", f"{mount}/{source}/")
            Path(mount, "persistence.conf").write_text(persistence_conf())
            os.sync()
        finally:
            run("umount", mount)
    return partition


def main():
    try:
        disk = boot_disk()
        start, size, number = plan(disk)
    except Skip as reason:
        log(f"nothing to do: {reason}")
        return 0
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        log(f"cannot check the disk: {type(error).__name__}")
        return 0
    try:
        partition = create(disk, start, size, number)
    except (OSError, subprocess.SubprocessError) as error:
        detail = error.stderr.strip()[-200:] if isinstance(error, subprocess.CalledProcessError) else ""
        log(f"creating the data partition failed: {type(error).__name__} {detail}")
        return 1
    log(f"data partition {partition} created ({size * SECTOR >> 20} MiB), restarting")
    subprocess.run(REBOOT, check=False, timeout=30)
    return 0


if __name__ == "__main__":
    sys.exit(main())
