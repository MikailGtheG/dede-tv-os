#!/bin/sh
# Debian 13 (trixie) exploratory live image; target: amd64 UEFI + BIOS.
# Not an A/B production image. No custom Kodi fork is shipped in this phase.
set -eu
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --debian-installer none \
  --archive-areas "main non-free-firmware" \
  --apt-recommends false \
  --bootappend-live "boot=live components quiet" \
  "${@}"
