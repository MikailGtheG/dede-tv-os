#!/bin/sh
# Debian 13 (trixie) exploratory live image; target: amd64 UEFI + BIOS.
# A/B updates boot from the dede-boot partition (hook 0600). No custom Kodi fork.
set -eu
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --bootloaders "grub-pc grub-efi" \
  --debian-installer none \
  --archive-areas "main non-free-firmware" \
  --apt-recommends false \
  --checksums sha256 \
  --bootappend-live "boot=live components persistence persistence-label=dede-data panic=10 quiet loglevel=3 vt.global_cursor_default=0 console=tty0 console=ttyS0,115200n8" \
  "${@}"
